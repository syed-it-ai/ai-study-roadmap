# Copy this file to .env and fill in your own values.
# .env is already in .gitignore, so your real key never gets committed.

# Which provider to use: groq, gemini, or ollama
LLM_PROVIDER=groq

# Your free API key. Leave blank if LLM_PROVIDER=ollama.
LLM_API_KEY=<redacted>

# Optional. If you leave this blank, llm_client.py picks a sensible
# free default for whichever provider you chose above.
LLM_MODEL=
