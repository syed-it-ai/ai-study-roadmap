# Copy this file to .env and fill in your own values.
# .env is already in .gitignore, so your real key never gets committed.

LLM_PROVIDER=groq
LLM_API_KEY=

# The model to use. openai/gpt-oss-120b is the project-wide default, and
# this stage specifically depends on it (or openai/gpt-oss-20b) supporting
# strict-mode structured output. Check console.groq.com/docs/structured-outputs
# before changing this if you want topic_1 and topic_4 to keep working.
LLM_MODEL=openai/gpt-oss-120b
